{
  "name": "local-deck-ai",
  "version": "0.1.0",
  "description": "Generate PowerPoint presentations from documents using local LLMs and Ollama.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "local-deck-ai": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "generate": "tsx src/cli/index.ts generate",
    "gui": "tsx src/cli/index.ts gui",
    "test": "tsx --test test/*.test.ts",
    "smoke": "tsx --test test/document-quality-smoke.test.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run lint && npm test && npm run smoke && npm run build && npm pack --dry-run",
    "start": "node dist/cli/index.js generate"
  },
  "keywords": [
    "ollama",
    "local-llm",
    "powerpoint",
    "pptx",
    "presentation",
    "slides",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "https://codeload.github.com/otcaveuni-dev/PptxGenJS/tar.gz/2ea5bafc5a1260c108c7200f6a36519bb6d35bd7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
